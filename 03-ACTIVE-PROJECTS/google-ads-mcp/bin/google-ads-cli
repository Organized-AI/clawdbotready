#!/usr/bin/env bash
set -euo pipefail

# Credential bridge: reads ~/.google-ads-cli/config.json and exports as env vars
# for the MCPorter-generated CLI which needs GOOGLE_ADS_* environment variables.

CONFIG_FILE="${HOME}/.google-ads-cli/config.json"
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CLI_BIN="${SCRIPT_DIR}/dist/google-ads-cli"

if [ ! -x "$CLI_BIN" ]; then
  echo "Error: CLI binary not found at $CLI_BIN"
  echo "Run 'npx tsc && npx mcporter generate-cli --command \"node dist/index.js\" --name google-ads-cli --compile dist/google-ads-cli' to build."
  exit 1
fi

# Load credentials from JSON config if env vars aren't already set
if [ -z "${GOOGLE_ADS_CLIENT_ID:-}" ] && [ -f "$CONFIG_FILE" ]; then
  export GOOGLE_ADS_CLIENT_ID=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE','utf8')).client_id || '')")
  export GOOGLE_ADS_CLIENT_SECRET=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE','utf8')).client_secret || '')")
  export GOOGLE_ADS_DEVELOPER_TOKEN=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE','utf8')).developer_token || '')")
  export GOOGLE_ADS_REFRESH_TOKEN=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE','utf8')).refresh_token || '')")
  export GOOGLE_ADS_CUSTOMER_ID=$(node -e "const c=JSON.parse(require('fs').readFileSync('$CONFIG_FILE','utf8')); console.log(c.customer_id || c.login_customer_id || '')")
  export GOOGLE_ADS_LOGIN_CUSTOMER_ID=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE','utf8')).login_customer_id || '')")
elif [ -z "${GOOGLE_ADS_CLIENT_ID:-}" ]; then
  echo "Error: No credentials found."
  echo "Either set GOOGLE_ADS_* env vars or create $CONFIG_FILE"
  exit 1
fi

exec "$CLI_BIN" "$@"
