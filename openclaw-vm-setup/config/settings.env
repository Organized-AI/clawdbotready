#===============================================================================
# OpenClaw VM Setup Configuration
#===============================================================================
# Customize these settings before running setup.sh
#===============================================================================

#===============================================================================
# Unified Instance Naming
#===============================================================================
# Set INSTANCE_NAME to automatically configure consistent naming across:
#   - Host macOS user (for VM access)
#   - VM name (Lume virtual machine)
#   - VM user (user account inside the VM)
#
# Example: INSTANCE_NAME="clawbot1" creates:
#   - Host user: clawbot1
#   - VM name: clawbot1-vm
#   - VM user: clawbot1
#
# Leave empty to configure each name individually below.

INSTANCE_NAME=""

#===============================================================================
# VM Configuration
#===============================================================================
# These can be set individually, or will be derived from INSTANCE_NAME

VM_NAME="openclaw-secure"         # VM name (or auto: ${INSTANCE_NAME}-vm)
VM_CPU="4"
VM_MEMORY="8192"                  # MB
VM_DISK="50GB"
VM_USER="clawuser"                # VM username (or auto: ${INSTANCE_NAME})
VM_PASSWORD="openclaw123"         # VM user password (for initial SSH key setup)

# Network
# VM_STATIC_IP=""         # Leave empty for DHCP

# Gateway Configuration
GATEWAY_PORT="8080"
GATEWAY_RATE_LIMIT="60"   # Requests per minute

# Monitoring
MONITOR_INTERVAL="5"      # Minutes between checks
ALERT_EMAIL=""            # Optional: email for alerts

# Backup
BACKUP_RETENTION_DAYS="7"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM (cron format)

#===============================================================================
# Host User Configuration (for dedicated VM access account)
#===============================================================================
# Set these to create a dedicated macOS user on the HOST machine
# This user will log in and access the VM via Screen Sharing
#
# If INSTANCE_NAME is set above, HOST_USER_NAME will default to that value.

HOST_USER_NAME=""              # Username (or auto: ${INSTANCE_NAME})
HOST_USER_FULLNAME=""          # Display name (or auto: "${INSTANCE_NAME} Operator")
HOST_USER_PASSWORD=""          # Password for the account (required if creating user)
HOST_USER_ADMIN="false"        # "true" to grant admin privileges, "false" for standard user
HOST_USER_AUTOLOGIN="false"    # "true" to enable auto-login (less secure, convenience)
HOST_USER_SHELL="/bin/zsh"     # Shell for the new user (default: zsh on modern macOS)
