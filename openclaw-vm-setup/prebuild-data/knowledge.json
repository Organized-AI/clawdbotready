  "best_practices": {
    "security": [
      {
        "id": "ssh-key-auth",
        "title": "SSH Key-Only Authentication",
        "description": "Disable password authentication, require Ed25519 SSH keys for all connections",
        "category": "security",
        "source": "discord:#security-tips",
        "author": "openclaw-security-team",
        "date": "2026-01-15",
        "priority": "required",
        "recommended_for": ["customer_support", "sales_outreach", "internal_comms", "custom"],
        "config": {
          "SSH_KEY_TYPE": "ed25519",
          "PASSWORD_AUTH": "no",
          "MAX_AUTH_TRIES": 3
        },
        "verification": {
          "command": "grep PasswordAuthentication /etc/ssh/sshd_config",
          "expected": "PasswordAuthentication no"
        }
      },
      {
        "id": "rate-limiting",
        "title": "Request Rate Limiting",
        "description": "Limit incoming requests to prevent abuse and ensure fair usage",
        "category": "security",
        "source": "discord:#production",
        "author": "poweruser#1234",
        "date": "2026-01-20",
        "priority": "recommended",
        "recommended_for": ["customer_support", "sales_outreach", "internal_comms", "custom"],
        "config": {
          "GATEWAY_RATE_LIMIT": "60",
          "RATE_LIMIT_BURST": "100",
          "RATE_LIMIT_WINDOW": "60"
        }
      },
      {
        "id": "firewall-localhost",
        "title": "Localhost-Only Firewall",
        "description": "Restrict VM network access to localhost connections only via SSH tunnel",
        "category": "security",
        "source": "manual",
        "author": "openclaw-team",
        "date": "2026-01-01",
        "priority": "required",
        "recommended_for": ["customer_support", "sales_outreach", "internal_comms", "custom"],
        "config": {
          "FIREWALL_MODE": "localhost_only"
        }
      },
      {
        "id": "exec-approvals",
        "title": "Deny-by-Default Command Execution",
        "description": "Use exec-approvals.json to whitelist only safe commands for AI agent execution",
        "category": "security",
        "source": "manual",
        "author": "openclaw-team",
        "date": "2026-01-01",
        "priority": "required",
        "recommended_for": ["customer_support", "sales_outreach", "internal_comms", "custom"],
        "config": {
          "EXEC_APPROVALS_ENABLED": "true"
        }
      }
    ],
