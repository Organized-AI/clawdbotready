{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/prebuild-config.json",
  "title": "Prebuild Configuration",
  "description": "User-selected configuration generated by the Prebuild Wizard",
  "type": "object",
  "required": ["version", "generated_at", "use_case", "skills", "best_practices", "integrations"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Config schema version",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this config was generated"
    },
    "knowledge_version": {
      "type": "string",
      "format": "date-time",
      "description": "Version of knowledge store used to generate this config"
    },
    "use_case": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["customer_support", "sales_outreach", "internal_comms", "custom"]
        },
        "template": {
          "type": "string",
          "description": "Specific template variant if applicable"
        },
        "description": {
          "type": "string",
          "description": "User-provided description for custom use cases"
        }
      }
    },
    "business_info": {
      "type": "object",
      "description": "Optional business context for commercial deployments",
      "properties": {
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "size": { "enum": ["solo", "small", "medium", "enterprise"] },
        "expected_volume": {
          "type": "string",
          "description": "Expected message volume (low/medium/high)"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "config": {
            "type": "object",
            "description": "Skill-specific configuration"
          }
        }
      }
    },
    "best_practices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "applied"],
        "properties": {
          "id": { "type": "string" },
          "applied": { "type": "boolean" },
          "config": {
            "type": "object",
            "description": "Practice-specific configuration overrides"
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "posthog": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["cloud", "self_hosted"] },
            "api_key_env": {
              "type": "string",
              "description": "Environment variable name for API key"
            },
            "host": {
              "type": "string",
              "format": "uri",
              "description": "Self-hosted PostHog URL"
            },
            "events": {
              "type": "array",
              "description": "Event types to track",
              "items": { "type": "string" }
            }
          }
        },
        "moltbook": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "entry_channels": {
              "type": "array",
              "items": { "type": "string" }
            },
            "auto_join": { "type": "boolean" }
          }
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval_minutes": { "type": "integer", "minimum": 1 },
            "alert_channels": {
              "type": "array",
              "items": { "enum": ["email", "slack", "webhook", "log"] }
            },
            "alert_email": { "type": "string", "format": "email" },
            "slack_webhook": { "type": "string", "format": "uri" }
          }
        },
        "backup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string", "description": "Cron expression" },
            "retention_days": { "type": "integer", "minimum": 1 },
            "destination": { "enum": ["local", "cloud", "external"] }
          }
        }
      }
    },
    "settings_overrides": {
      "type": "object",
      "description": "Direct overrides for settings.env values",
      "additionalProperties": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "wizard_version": { "type": "string" },
        "user_agent": { "type": "string" },
        "session_id": { "type": "string" },
        "duration_seconds": { "type": "integer" }
      }
    }
  }
}
