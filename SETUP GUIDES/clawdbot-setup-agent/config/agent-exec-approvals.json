{
  "version": "1.0",
  "description": "Clawdbot Setup Assistant - Enhanced exec-approvals for remote setup automation",
  "context": "setup-assistant-agent",
  "default_action": "deny",
  "log_all_attempts": true,
  "log_file": "~/.openclaw/logs/setup-agent-exec.log",
  "alert_on_deny": true,

  "rules": [
    {
      "id": "allow-setup-script",
      "description": "Master setup script execution",
      "binary": "/bin/bash",
      "action": "allow",
      "argument_rules": {
        "allowed_scripts": [
          "*/SETUP GUIDES/openclaw-vm-setup/setup.sh",
          "*/SETUP GUIDES/openclaw-native-setup/setup.sh"
        ],
        "allowed_args": ["0", "1", "2", "3", "4", "5", "6", "7", "all", "start", "continue"],
        "max_args": 2
      }
    },

    {
      "id": "allow-helper-scripts",
      "description": "Setup helper scripts",
      "binary": "/bin/bash",
      "action": "allow",
      "argument_rules": {
        "allowed_scripts": [
          "*/openclaw-vm-setup/scripts/*.sh",
          "*/openclaw-native-setup/scripts/*.sh",
          "*/clawdbot-setup-agent/scripts/*.sh"
        ],
        "forbidden_patterns": ["rm -rf", "format", "dd"]
      }
    },

    {
      "id": "allow-homebrew",
      "description": "Homebrew package manager",
      "binary": "/opt/homebrew/bin/brew",
      "action": "allow",
      "argument_rules": {
        "allowed_commands": ["install", "uninstall", "list", "info", "update", "doctor"],
        "allowed_packages": ["lume", "node", "pnpm", "jq", "git"],
        "forbidden_args": ["--force"]
      }
    },

    {
      "id": "allow-lume",
      "description": "Lume hypervisor commands",
      "binary": "/usr/local/bin/lume",
      "action": "allow",
      "argument_rules": {
        "allowed_commands": ["create", "start", "stop", "list", "status", "delete"],
        "vm_name_pattern": "^openclaw-",
        "forbidden_args": ["--force-delete", "--no-snapshot"]
      }
    },

    {
      "id": "allow-ssh-keygen",
      "description": "SSH key generation (for VM access)",
      "binary": "/usr/bin/ssh-keygen",
      "action": "allow",
      "argument_rules": {
        "allowed_types": ["-t ed25519", "-t rsa"],
        "required_prefix": ["~/.ssh/openclaw"],
        "forbidden_patterns": ["/etc/ssh", "/root/.ssh"]
      }
    },

    {
      "id": "allow-ssh-to-vm",
      "description": "SSH to OpenClaw VM only",
      "binary": "/usr/bin/ssh",
      "action": "allow",
      "argument_rules": {
        "allowed_destinations": [
          "clawuser@192.168.64.*",
          "clawuser@localhost",
          "clawuser@127.0.0.1"
        ],
        "required_keys": ["~/.ssh/openclaw_vm_ed25519"],
        "forbidden_patterns": ["-D", "-R", "-L", "ProxyJump"]
      }
    },

    {
      "id": "allow-scp-to-vm",
      "description": "SCP to VM for config files",
      "binary": "/usr/bin/scp",
      "action": "allow",
      "argument_rules": {
        "allowed_destinations": [
          "clawuser@192.168.64.*:/home/clawuser/.openclaw",
          "clawuser@localhost:/home/clawuser/.openclaw"
        ],
        "allowed_file_patterns": ["*.json", "*.env", "*.sh", "*.md"],
        "max_file_size_mb": 10
      }
    },

    {
      "id": "allow-pnpm",
      "description": "pnpm package manager (for OpenClaw install)",
      "binary": "/Users/*/Library/pnpm/pnpm",
      "action": "allow",
      "argument_rules": {
        "allowed_commands": ["install", "add", "remove", "list", "exec"],
        "forbidden_patterns": ["postinstall script", "preinstall script"]
      }
    },

    {
      "id": "allow-git-clone",
      "description": "Git clone for OpenClaw repo",
      "binary": "/usr/bin/git",
      "action": "allow",
      "argument_rules": {
        "allowed_commands": ["clone"],
        "allowed_repos": [
          "https://github.com/OpenClawDev/openclaw.git",
          "https://github.com/YOUR-REPO/clawdbot-ready.git"
        ],
        "max_repo_size_mb": 500
      }
    },

    {
      "id": "allow-system-checks",
      "description": "System information queries",
      "binary": [
        "/usr/bin/sw_vers",
        "/usr/bin/uname",
        "/bin/df",
        "/sbin/ping",
        "/usr/bin/whoami",
        "/usr/bin/hostname"
      ],
      "action": "allow",
      "argument_rules": {
        "safe_only": true
      }
    },

    {
      "id": "allow-file-ops-workspace",
      "description": "File operations in workspace only",
      "binary": ["/bin/mkdir", "/bin/cp", "/bin/mv"],
      "action": "allow",
      "argument_rules": {
        "required_prefix": [
          "~/.openclaw",
          "~/clawdbot-ready",
          "/tmp/setup-assistant"
        ],
        "forbidden_patterns": ["..", "/etc", "/var", "/usr", "/System"]
      }
    },

    {
      "id": "allow-cat-config",
      "description": "Read config files",
      "binary": "/bin/cat",
      "action": "allow",
      "argument_rules": {
        "allowed_paths": [
          "~/.openclaw/*.{json,env,log}",
          "~/clawdbot-ready/**/*.{md,json,sh,env}",
          "~/.ssh/config",
          "~/.zprofile",
          "~/.zshrc"
        ],
        "forbidden_patterns": [
          "password",
          "secret",
          "credential",
          "private_key",
          ".pem"
        ]
      }
    },

    {
      "id": "allow-echo",
      "description": "Basic output",
      "binary": "/bin/echo",
      "action": "allow",
      "argument_rules": {
        "max_args": 20,
        "max_total_length": 2000,
        "forbidden_patterns": [">>", ">", "|", ";", "`", "$("]
      }
    },

    {
      "id": "allow-chmod-workspace",
      "description": "Permission changes in workspace",
      "binary": "/bin/chmod",
      "action": "allow",
      "argument_rules": {
        "allowed_modes": ["644", "755", "600", "700", "+x"],
        "required_prefix": [
          "~/.openclaw",
          "~/clawdbot-ready",
          "~/.ssh/openclaw_vm_ed25519"
        ],
        "forbidden_patterns": ["-R /", "777"]
      }
    },

    {
      "id": "allow-crontab-view",
      "description": "View crontab (for backup verification)",
      "binary": "/usr/bin/crontab",
      "action": "allow",
      "argument_rules": {
        "allowed_args": ["-l"],
        "forbidden_args": ["-e", "-r"]
      }
    },

    {
      "id": "allow-launchctl-list",
      "description": "List LaunchAgents (for monitoring verification)",
      "binary": "/bin/launchctl",
      "action": "allow",
      "argument_rules": {
        "allowed_commands": ["list"],
        "allowed_patterns": ["openclaw"],
        "forbidden_commands": ["load", "unload", "start", "stop", "remove"]
      }
    },

    {
      "id": "allow-ps-filter",
      "description": "Process list (filtered to OpenClaw only)",
      "binary": "/bin/ps",
      "action": "allow",
      "argument_rules": {
        "required_grep": "openclaw|lume",
        "forbidden_patterns": ["-aux", "-ef"]
      }
    },

    {
      "id": "allow-tail-logs",
      "description": "Read log files",
      "binary": "/usr/bin/tail",
      "action": "allow",
      "argument_rules": {
        "allowed_paths": [
          "~/.openclaw/logs/*.log",
          "~/clawdbot-ready/SETUP GUIDES/*/logs/*.log"
        ],
        "max_lines": 1000
      }
    },

    {
      "id": "deny-curl-external",
      "description": "DENY curl to external sites (except setup sources)",
      "binary": "/usr/bin/curl",
      "action": "conditional",
      "argument_rules": {
        "allowed_domains": [
          "YOUR-SERVER.com",
          "github.com",
          "raw.githubusercontent.com",
          "lume.dev",
          "install.lume.sh"
        ],
        "deny_all_others": true
      },
      "alert": true
    },

    {
      "id": "deny-wget",
      "description": "DENY wget - use curl with domain restrictions",
      "binary": "/usr/bin/wget",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-nc",
      "description": "DENY netcat - backdoor risk",
      "binary": "/usr/bin/nc",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-ssh-external",
      "description": "DENY SSH to external servers",
      "binary": "/usr/bin/ssh",
      "action": "deny_unless_vm",
      "argument_rules": {
        "allowed_destinations": [
          "clawuser@192.168.64.*",
          "clawuser@localhost"
        ],
        "deny_all_others": true
      },
      "alert": true
    },

    {
      "id": "deny-sudo",
      "description": "DENY sudo - no privilege escalation",
      "binary": "/usr/bin/sudo",
      "action": "deny",
      "alert": true,
      "message": "Setup should not require sudo. If this command failed, investigate why."
    },

    {
      "id": "deny-su",
      "description": "DENY su - no user switching",
      "binary": "/usr/bin/su",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-rm-dangerous",
      "description": "DENY dangerous rm operations",
      "binary": "/bin/rm",
      "action": "deny_if",
      "argument_rules": {
        "dangerous_patterns": [
          "-rf /",
          "-rf ~",
          "-rf /*",
          "-rf /System",
          "-rf /Library",
          "-rf /Applications"
        ]
      },
      "alert": true,
      "message": "Dangerous rm operation blocked. This would delete critical files."
    },

    {
      "id": "deny-format",
      "description": "DENY disk formatting",
      "binary": "/sbin/diskutil",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-dd",
      "description": "DENY dd - disk imaging risk",
      "binary": "/bin/dd",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-osascript",
      "description": "DENY osascript - system control",
      "binary": "/usr/bin/osascript",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-security-keychain",
      "description": "DENY keychain access",
      "binary": "/usr/bin/security",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-defaults-write",
      "description": "DENY system preferences modification",
      "binary": "/usr/bin/defaults",
      "action": "deny_unless_read",
      "argument_rules": {
        "allowed_commands": ["read"],
        "forbidden_commands": ["write", "delete"]
      },
      "alert": true
    },

    {
      "id": "deny-dscl",
      "description": "DENY user/group management",
      "binary": "/usr/bin/dscl",
      "action": "deny",
      "alert": true
    },

    {
      "id": "deny-kill",
      "description": "DENY process termination (except setup processes)",
      "binary": ["/bin/kill", "/usr/bin/pkill", "/usr/bin/killall"],
      "action": "conditional",
      "argument_rules": {
        "allowed_processes": ["setup.sh", "lume", "openclaw"],
        "deny_all_others": true
      },
      "alert": true
    },

    {
      "id": "deny-pfctl",
      "description": "DENY firewall modification",
      "binary": "/sbin/pfctl",
      "action": "deny",
      "alert": true,
      "message": "Firewall rules should be managed by setup scripts, not directly."
    },

    {
      "id": "deny-python-exec",
      "description": "DENY arbitrary Python execution",
      "binary": "/usr/bin/python*",
      "action": "conditional",
      "argument_rules": {
        "allowed_scripts": [
          "~/clawdbot-ready/SETUP GUIDES/*/scripts/*.py"
        ],
        "forbidden_flags": ["-c", "--command"],
        "deny_all_others": true
      },
      "alert": true
    },

    {
      "id": "deny-node-exec",
      "description": "DENY arbitrary Node.js execution",
      "binary": ["/usr/local/bin/node", "/opt/homebrew/bin/node"],
      "action": "conditional",
      "argument_rules": {
        "allowed_scripts": [
          "~/clawdbot-ready/SETUP GUIDES/*/scripts/*.js",
          "~/.openclaw/node_modules/.bin/*"
        ],
        "forbidden_flags": ["-e", "--eval"],
        "deny_all_others": true
      },
      "alert": true
    }
  ],

  "environment_restrictions": {
    "blocklist": [
      "PATH",
      "LD_LIBRARY_PATH",
      "DYLD_*",
      "NODE_OPTIONS",
      "PYTHONPATH",
      "RUBYOPT",
      "PERL5OPT",
      "BASH_ENV",
      "ENV",
      "CDPATH",
      "GLOBIGNORE",
      "SHELLOPTS"
    ],
    "allowlist": [
      "HOME",
      "USER",
      "SHELL",
      "TMPDIR",
      "OPENCLAW_*"
    ]
  },

  "rate_limiting": {
    "max_commands_per_minute": 60,
    "max_failed_attempts": 10,
    "lockout_duration_seconds": 300
  },

  "audit_rules": {
    "log_command_output": true,
    "log_command_duration": true,
    "alert_on_pattern": [
      "password",
      "secret",
      "token",
      "api_key",
      "private_key"
    ],
    "daily_summary": true,
    "send_summary_to": "admin@your-domain.com"
  },

  "emergency_stop": {
    "trigger_file": "~/.openclaw/EMERGENCY_STOP",
    "action": "block_all_commands",
    "notify": ["admin@your-domain.com", "sms:+1234567890"]
  },

  "notes": [
    "This configuration allows setup-related commands while blocking dangerous operations",
    "All commands are logged and monitored for suspicious patterns",
    "SSH access is restricted to local VM only (192.168.64.* range)",
    "Network egress is limited to trusted domains (GitHub, Lume, your server)",
    "No privilege escalation (sudo/su) is permitted",
    "File operations are restricted to workspace directories only",
    "Emergency stop can be triggered by creating ~/.openclaw/EMERGENCY_STOP file"
  ]
}
