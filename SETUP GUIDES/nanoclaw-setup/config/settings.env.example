# NanoClaw Configuration
# Copy to .env and customize before running install-service.sh

# ============================================================
# Assistant Settings
# ============================================================

# Trigger word — users type this in WhatsApp to invoke Claude
# Example: @Andy what's the weather?
ASSISTANT_NAME="Andy"

# ============================================================
# Paths
# ============================================================

# Where NanoClaw is cloned (auto-detected by scripts if not set)
# NANOCLAW_ROOT="/Users/$(whoami)/nanoclaw"

# Node.js binary path (auto-detected if not set)
# NODE_PATH="/opt/homebrew/bin/node"

# ============================================================
# Container Settings
# ============================================================

# Container image name
CONTAINER_IMAGE="nanoclaw-agent:latest"

# Max concurrent container instances
MAX_CONCURRENT_CONTAINERS=5

# Container timeout in minutes
CONTAINER_TIMEOUT_MINUTES=30

# Container runtime: "apple" or "docker"
CONTAINER_RUNTIME="apple"

# ============================================================
# Claude Authentication (pick ONE method)
# ============================================================

# Option A: Claude subscription (OAuth) — run `claude setup-token` first
# The token is auto-discovered from Claude Code config

# Option B: Anthropic API key — uncomment and set:
# ANTHROPIC_API_KEY="sk-ant-your-key-here"

# ============================================================
# Monitoring
# ============================================================

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=300

# Log rotation threshold in MB
LOG_MAX_SIZE_MB=100

# Log retention in days
LOG_RETENTION_DAYS=30
