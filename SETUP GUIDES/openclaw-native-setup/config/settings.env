# Native macOS Deployment Settings
# Configuration for openclaw-native-setup automation toolkit
#
# This file contains user-customizable settings for deploying OpenClaw Gateway
# directly on macOS (without virtualization). Modify values as needed for your
# environment before running setup.sh.

# ============================================================================
# USER ACCOUNT CONFIGURATION
# ============================================================================

# Username for the dedicated OpenClaw user account
# This user will be created with minimal privileges to run the Gateway
OPENCLAW_USER="openclaw"

# User ID (UID) for the openclaw account
# Must be unique on the system. Default 502 is typically available.
# Check existing UIDs with: dscl . -list /Users UniqueID
OPENCLAW_UID="502"

# Home directory path for the openclaw user
# All Gateway files, logs, and data will be stored here
OPENCLAW_HOME="/Users/openclaw"

# ============================================================================
# GATEWAY INSTALLATION PATHS
# ============================================================================

# Directory where the Gateway binary will be installed
# Permissions: 500 (read/execute for owner only)
GATEWAY_INSTALL_DIR="${OPENCLAW_HOME}/.openclaw/gateway"

# Directory for Gateway runtime data (databases, cache, etc.)
# Permissions: 700 (full access for owner only)
GATEWAY_DATA_DIR="${OPENCLAW_HOME}/.openclaw/data"

# Directory for Gateway logs (stdout, stderr, monitoring)
# Permissions: 700 (full access for owner only)
GATEWAY_LOG_DIR="${OPENCLAW_HOME}/.openclaw/logs"

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Path to exec-approvals.json (deny-by-default command allowlist)
# This file will be owned by root and read-only to prevent tampering
# Permissions: 444 (read-only for all, owned by root:wheel)
EXEC_APPROVALS_PATH="${OPENCLAW_HOME}/.openclaw/exec-approvals.json"

# LaunchAgent plist path for automatic Gateway startup
# Permissions: 444 (read-only for all, owned by root:wheel)
LAUNCHAGENT_PLIST="${OPENCLAW_HOME}/Library/LaunchAgents/ai.openclaw.gateway.plist"

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

# Interval between monitoring checks (seconds)
# Default: 300 (5 minutes)
MONITOR_INTERVAL=300

# Maximum log file size before rotation (MB)
# When a log exceeds this size, it will be rotated
LOG_MAX_SIZE_MB=100

# Number of days to retain old logs before deletion
# Older logs will be automatically cleaned up
LOG_RETENTION_DAYS=30

# Alert threshold for CPU usage (percentage)
# Monitoring will alert if Gateway exceeds this CPU usage
CPU_ALERT_THRESHOLD=80

# Alert threshold for memory usage (MB)
# Monitoring will alert if Gateway exceeds this memory usage
MEMORY_ALERT_THRESHOLD=1024

# ============================================================================
# GATEWAY CONFIGURATION (Optional)
# ============================================================================

# Gateway download URL (if available)
# Leave empty to skip automatic download (manual installation required)
GATEWAY_DOWNLOAD_URL=""

# Gateway version to install
# Used for verification and logging
GATEWAY_VERSION="latest"

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Force mode: Skip confirmation prompts
# Set to "true" for automated deployments
# WARNING: This will overwrite existing configurations
FORCE_MODE="false"

# Backup existing user account before overwriting
# Set to "true" to backup /Users/openclaw before recreating
BACKUP_BEFORE_OVERWRITE="true"

# Backup directory for configuration backups
BACKUP_DIR="${PWD}/backups"

# Enable verbose logging during setup
# Set to "true" for detailed debugging output
VERBOSE="false"

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
